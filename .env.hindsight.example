# Hindsight API 0.9.2; copy to .env.hindsight and chmod 600.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:replace_with_database_password@127.0.0.1:5432/hindsight
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_WORKERS=1
HINDSIGHT_API_MCP_ENABLED=false

HINDSIGHT_API_LLM_PROVIDER=openai-codex
HINDSIGHT_API_LLM_MODEL=gpt-5.3-codex-spark
CODEX_HOME=/data/pi-agent/cas-personal-agent/var/hindsight-codex
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1

HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/replace_with_account_id/ai/v1
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=replace_with_minimum_scope_token
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=@cf/qwen/qwen3-embedding-0.6b
HINDSIGHT_API_EMBEDDINGS_MAX_INPUT_TOKENS=8192
HINDSIGHT_API_RERANKER_PROVIDER=rrf
# Ubuntu 24.04 packages pgvector 0.6; iterative scans require pgvector 0.8+.
HINDSIGHT_API_ANN_ITERATIVE_SCAN=false
