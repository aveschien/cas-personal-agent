[Unit]
Description=Hindsight API for CAS Personal Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/pi-agent/cas-personal-agent
EnvironmentFile=/data/pi-agent/cas-personal-agent/.env.hindsight
Environment=PATH=/data/pi-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/data/pi-agent/.local/bin/hindsight-api --host 127.0.0.1 --port 8888 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
