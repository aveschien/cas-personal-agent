{
  "name": "cas-personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start:live": "node dist/src/live-cli.js",
    "verify:pi": "npm run build && node dist/src/pi-smoke.js",
    "verify:bitable": "npm run build && node dist/src/bitable-smoke.js",
    "verify:mixed": "npm run build && node dist/src/mixed-input-smoke.js",
    "verify:memory-candidate": "npm run build && node dist/src/memory-candidate-smoke.js",
    "verify:memory": "npm run build && node dist/src/memory-smoke.js"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@vectorize-io/hindsight-client": "0.9.2",
    "typebox": "1.3.7"
  }
}
