CAS_DATABASE_PATH=./var/cas-agent.sqlite
CAS_ALLOWED_USER_IDS=ou_your_feishu_user_id
CAS_PI_SESSION_DIR=./var/pi-sessions
CAS_PI_MODEL=openai-codex/gpt-5.6-luna
CAS_BITABLE_BASE_TOKEN=your_base_token
CAS_BITABLE_PROJECTS_TABLE_ID=your_projects_table_id
CAS_BITABLE_ITEMS_TABLE_ID=your_items_table_id
CAS_BITABLE_ACTION_LINKS_TABLE_ID=your_action_links_table_id
CAS_LOG_LEVEL=info
MEMORY_ENABLED=true
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_BANK_ID=cas-personal-agent
HINDSIGHT_RECALL_TIMEOUT_MS=2000
HINDSIGHT_RECALL_MAX_RESULTS=5
HINDSIGHT_RECALL_MAX_TOKENS=800
